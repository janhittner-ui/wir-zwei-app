# Kopiere diese Datei zu ".env" und trage die Werte aus Supabase ein
# (Supabase → Project Settings → API Keys / Data API).
# Ohne diese Werte startet die App im Demo-Modus.
# Erst einschalten, wenn eigener SMTP-Versand mit {{ .Token }} in der Vorlage steht:
# EXPO_PUBLIC_EMAIL_CODES=1
EXPO_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
