{
  "expo": {
    "name": "CoPlanning",
    "slug": "paarweise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "paarweise",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "de.paarweise.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "de.paarweise.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F4F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Damit du Bilder in euer gemeinsames Album legen kannst, braucht die App Zugriff auf deine Fotos.",
          "cameraPermission": "Damit du Fotos direkt für euer gemeinsames Album aufnehmen kannst, braucht die App die Kamera.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "owner": "janjulius",
    "extra": {
      "eas": {
        "projectId": "7a13743a-0120-4c8f-8ec4-53babebdc77b"
      }
    }
  }
}
